{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "docs:sync": "node scripts/sync-framework-docs.mjs",
    "docs:update": "node scripts/sync-framework-docs.mjs --update-llms",
    "dev": "npm run docs:sync && mado dev",
    "build": "npm run docs:sync && mado build",
    "typecheck": "npm run docs:sync && mado typecheck",
    "test": "npm run docs:sync && mado typecheck && npm run test:contract && node test/browser/site.browser.mjs",
    "test:contract": "node --test test/proof-contract.test.mjs",
    "test:browser": "npm run docs:sync && node test/browser/site.browser.mjs",
    "verify": "npm run docs:sync && mado typecheck && mado build",
    "release": "npm run docs:sync && mado release",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:edge": "node scripts/verify-edge.mjs",
    "preview": "mado preview",
    "preview:edge": "wrangler dev",
    "deploy": "node scripts/deploy-production.mjs",
    "new": "mado new"
  },
  "dependencies": {
    "@madojs/mado": "0.15.2"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "marked": "18.0.7",
    "playwright-core": "^1.61.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.115.0"
  }
}
